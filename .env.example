# Copy to .env.local and fill in. Never commit real values.

# Required in production. Optional in local dev (falls back to an embedded PGlite DB in .data/).
DATABASE_URL=

# Random 32+ char secrets: openssl rand -hex 32
APP_SECRET=
# Needed once to create the parent account at /parent/setup
SETUP_TOKEN=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# STT_MODEL=gpt-4o-mini-transcribe
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=shimmer
# MONTHLY_BUDGET_USD=40

# Dev only: fake providers, clearly labelled in the UI. Refused when NODE_ENV=production.
# PROVIDER_MODE=mock
